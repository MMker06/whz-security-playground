# whz-security-playground 환경변수 예시
# 이 파일을 .env 로 복사해서 값을 채운 뒤 `docker compose up -d --build` 하세요.
# .env 는 .gitignore 에 등록돼 있어 커밋되지 않습니다.

# 자동 채점 토큰(HMAC-SHA256) 서명에 쓰이는 비밀키.
# 이 값이 유출되면 누구나 토큰을 위조해 api/solve.php 로 점수를 자가 지급할 수 있습니다.
# 반드시 직접 만든 랜덤 문자열로 바꿔주세요.  예) openssl rand -hex 32
CHALLENGE_SECRET=change_me_to_a_random_string

# MySQL 컨테이너 root 계정 비밀번호 (로컬 전용)
MYSQL_ROOT_PASSWORD=change_me_too
